{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Launcher",
  "version": "1.1.0",
  "identifier": "dev.sshlauncher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:client",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSH Launcher",
        "width": 760,
        "height": 500,
        "minWidth": 760,
        "minHeight": 500,
        "maxWidth": 760,
        "maxHeight": 500,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "alwaysOnTop": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
